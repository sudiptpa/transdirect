{
   "name":"sudiptpa/transdirect",
   "type":"library",
   "description":"A clean, dependency-free PHP client for the Transdirect REST API.",
   "keywords":[
      "transdirect",
      "api",
      "shipping",
      "courier"
   ],
   "license":"MIT",
   "authors":[
      {
         "name":"Sujip Thapa",
         "email":"sudiptpa@gmail.com",
         "homepage":"https://sujipthapa.co",
         "role":"Developer"
      }
   ],
   "require":{
      "php":">=7.0"
   },
   "suggest":{
      "ext-curl":"Recommended for more reliable HTTP transport."
   },
   "require-dev":{
      "phpunit/phpunit":"^6.5 || ^9.6",
      "phpstan/phpstan":"^1.12"
   },
   "extra":{
      "branch-alias":{
         "dev-master":"1.0.x-dev"
      }
   },
   "autoload":{
      "psr-4":{
         "Sujip\\Transdirect\\":"src/"
      }
   },
   "autoload-dev":{
      "psr-4":{
         "Sujip\\Transdirect\\Test\\":"tests/"
      }
   },
   "scripts":{
      "test":"vendor/bin/phpunit",
      "stan":"vendor/bin/phpstan analyse --configuration=phpstan.neon.dist"
   }
}
